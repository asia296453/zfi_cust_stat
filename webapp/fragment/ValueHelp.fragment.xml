<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="valueHelpDialog"
        title="Select Value"
        contentWidth="700px"
        contentHeight="500px"
        draggable="true"
        resizable="true">
        <VBox class="sapUiSmallMargin">
            <SearchField
                id="sfValueHelp"
                width="100%"
                liveChange=".onValueHelpSearch"/>
            <Table
                id="tblValueHelp"
                mode="MultiSelect"
                growing="true"
                growingScrollToLoad="true">
                <columns>
                    <Column width="150px">
                        <Text text="Code"/>
                    </Column>
                    <Column>
                        <Text text="Description"/>
                    </Column>
                </columns>
            </Table>
        </VBox>
        <beginButton>
            <Button
                text="OK"
                type="Emphasized"
                press=".onValueHelpOk"/>
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onValueHelpCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>